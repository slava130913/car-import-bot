# Токен бота от @BotFather
BOT_TOKEN=

# Telegram id администраторов через запятую (узнать: @userinfobot). Им приходят заказы и заявки.
ADMIN_IDS=

# Цена отчёта по VIN в Telegram Stars. 0 = без встроенной оплаты, бот покажет PAYMENT_INSTRUCTIONS.
VIN_PRICE_STARS=0

# Текст, который видит клиент после заказа, если VIN_PRICE_STARS=0
PAYMENT_INSTRUCTIONS=Мы свяжемся с вами для оплаты и пришлём отчёт в течение 24 часов.

# Username бота без @ (нужен сайту для кнопок «Проверить VIN» и «Заявка»)
BOT_USERNAME=

# Брендирование под клиента: название компании в приветствии и прямой контакт менеджера (необязательно)
BRAND_NAME=
MANAGER_CONTACT=

# Ссылка на веб-калькулятор (необязательно, показывается в /start). Боты клиентов открывают его
# в кнопке меню со своими параметрами: ?bot=...&brand=...&fee=...
WEB_URL=

# Боты клиентов (white label): компания запускает свой бот сама через /start partner → «Запустить свой бот».
# Все боты работают в этом же процессе, токены хранятся в базе. Длительность пробного периода в днях:
TRIAL_DAYS=7
# Куда клиенту писать об оплате после пробного периода, например t.me/ваш_бот?start=partner
PLATFORM_CONTACT=

# Ключ Anthropic: включает в боте распознавание скриншотов объявлений и ответы на вопросы своими словами,
# а также перевод отчётов в scripts/vin_report.py. Без ключа бот работает, ИИ-функции просят ввести данные вручную.
ANTHROPIC_API_KEY=
# Модель и лимит обращений к ИИ на человека в сутки (защита от расходов)
AI_MODEL=claude-opus-5
AI_DAILY_LIMIT=30

# Путь к базе (по умолчанию data/bot.sqlite3)
# DB_PATH=

# Docker: порт сайта на локальной машине и сеть общего Caddy на сервере
WEB_PORT=8080
EDGE_NETWORK=bytoprompt-studio_default

# Копия бота для клиента на том же сервере: своё имя проекта Docker и своё имя сайта в сети Caddy
# COMPOSE_PROJECT_NAME=car-client1
# WEB_ALIAS=client1-web
